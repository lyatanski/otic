out=bins
mkdir -p $out

if [ ! -f $out/test.c ]; then
echo -- creating source
cat << EOF > $out/test.c
int f1(int a) {
}

int f2(int b, int c) {
}

int f3(int d, int e, int f) {
}

int main() {
    if(3) return 4;
    else return 2;
    return 42;
}
EOF
fi

echo -- compile all-in
gcc -Wall -Wextra -ggdb -Os -o$out/one main.c
strip -s $out/one

for file in main core ia64 arm8 elfs mach
do
  src=$file.c
  dst=$out/$file.o
  #if [ $src -nt $dst ]; then
    echo -- compile $src
    gcc -Dpart -Wall -Wextra -c -ggdb -O0 -o$dst $src || exit $?
  #fi
  link="$link $dst"
done

echo "--- exec"
gcc -o$out/tic $link && ./$out/tic -m exec $out/test.c
