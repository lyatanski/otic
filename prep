#!/bin/sh -e
out=bins
mkdir -p $out

echo -- build
gcc -Wall -Wextra -ggdb -Os -o$out/one main.c
strip -s $out/one

for file in main util core link ia64 arm8 elfs ario mach pe32
do
  src=$file.c
  dst=$out/$file.o
    gcc -Dpart -Wall -Wextra -c -ggdb -O0 -o$dst $src || exit $?
  link="$link $dst"
done

echo "--- test"
for spec in core ia64 arm8 elfs mach pe32; do
  gcc -Wall -Wextra -o$out/test-$spec test/$spec.c && $out/test-$spec
done
gcc -Wall -Wextra -o$out/test test/main.c && $out/test
